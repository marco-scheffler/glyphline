<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <!-- Wired to the build setting rather than hard-coded, so project.yml stays the
       single source of truth. Without this key the built bundle carries no
       identifier at all: `UserDefaults.standard` does not resolve to the app's
       own domain, and Keychain item identity — which depends on the bundle
       identifier plus the code signature — has nothing stable to bind to. -->
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <!-- Which localisation the bundle falls back to when the reader's Mac is set
       to a language this app does not carry. Without the key CFBundle picks
       whichever .lproj it happens to find first, so a Korean Mac could land on
       French — a wrong language chosen at random reads as a broken app, where
       the development language reads as "not translated yet". Wired to the
       build setting for the same reason the bundle identifier is. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key>
  <string>Glyphline</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key>
  <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
</dict>
</plist>
