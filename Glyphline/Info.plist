<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <!-- Wired to the build setting rather than hard-coded, so project.yml stays the
       single source of truth. Without this key the built bundle carries no
       identifier at all: `UserDefaults.standard` does not resolve to the app's
       own domain, and Keychain item identity — which depends on the bundle
       identifier plus the code signature — has nothing stable to bind to. -->
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <!-- Which localisation the bundle falls back to when the reader's Mac is set
       to a language this app does not carry. Without the key CFBundle picks
       whichever .lproj it happens to find first, so a Korean Mac could land on
       French — a wrong language chosen at random reads as a broken app, where
       the development language reads as "not translated yet". Wired to the
       build setting for the same reason the bundle identifier is. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key>
  <string>Glyphline</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key>
  <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
  <!-- Where the app asks whether a newer Glyphline exists. Served straight out
       of the repository rather than from a server of its own: there is no
       infrastructure to keep alive, the file is versioned, and what was
       published is visible in the diff. raw.githubusercontent.com caches for a
       few minutes, so a fresh release is not offered the same second it is
       pushed — which is fine, and better than an outage nobody notices. -->
  <key>SUFeedURL</key>
  <string>https://raw.githubusercontent.com/marco-scheffler/glyphline/main/appcast.xml</string>
  <!-- The public half of the key every update is signed with. Public on purpose:
       it belongs in every copy of the app, because it is what a copy uses to
       check that a download really came from here. The private half lives in
       the maintainer's Keychain and appears in no file in this repository —
       whoever holds it can hand any Glyphline user arbitrary code, past Apple's
       notarisation, so a leak of it is not a bug in this app but a compromise of
       everyone running it. -->
  <key>SUPublicEDKey</key>
  <string>tKT5C8wnbAp6bhQhMr901+MJ82Es9Hq0++5HuBzqQRg=</string>
  <!-- Once a day. Sparkle's own default is a week, which for an app that ships
       fixes to a menu bar someone watches all day is too slow to be useful. -->
  <key>SUScheduledCheckInterval</key>
  <integer>86400</integer>
</dict>
</plist>
