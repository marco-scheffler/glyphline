          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière synchronisation a échoué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima sincronizzazione non è riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
