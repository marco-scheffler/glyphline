    "The dashboard's cards are glass: they take their colour from whatever is behind them, so this sets the whole window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karten des Dashboards sind aus Glas: Sie nehmen ihre Farbe von dem an, was hinter ihnen liegt — diese Einstellung färbt also das ganze Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dashboard's cards are glass: they take their colour from whatever is behind them, so this sets the whole window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas del Dashboard son de cristal: toman su color de lo que hay detrás, así que esto define toda la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes du Dashboard sont en verre : elles prennent la couleur de ce qui se trouve derrière elles, ce réglage colore donc toute la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede della Dashboard sono di vetro: prendono il colore da ciò che sta dietro, quindi questa impostazione riguarda l’intera finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダッシュボードのカードはガラスです。背後にあるものから色を受け取るため、この設定はウインドウ全体に及びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões do Dashboard são de vidro: eles tiram a cor do que está atrás deles, então isto define a janela inteira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仪表板的卡片是玻璃：颜色取自它们背后的内容，因此这项设置会影响整个窗口。"
          }
        }
      }
    },
    "The last sync failed." : {
      "comment" : "Attention reason for an account whose last sync run failed without a message of its own.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzte Synchronisierung ist fehlgeschlagen."
          }
        },
        "en" : {
