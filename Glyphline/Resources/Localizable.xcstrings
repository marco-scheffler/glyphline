{
  "sourceLanguage": "en",
  "strings": {
    "% free": {
      "shouldTranslate": false
    },
    "%@ %@": {
      "comment": "Menu row tail. Placeholders: the window's verb ('resets' or 'ends') and a clock time or date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld%% — %@": {
      "comment": "Menu row. Placeholders: the window's short name, the percentage used, and the tail ('resets 14:00').",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld%% — %3$@"
          }
        }
      }
    },
    "%@ (as of %@)": {
      "comment": "Menu row qualified with when the figure was last believed. Placeholders: the row so far, and an instant.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (as of %2$@)"
          }
        }
      }
    },
    "%@ any moment": {
      "comment": "Quota row with under a minute left. The placeholder is the window's verb, 'resets' or 'ends'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ any moment"
          }
        }
      }
    },
    "%@ in %@": {
      "comment": "Quota row countdown. Placeholders: the window's verb ('resets' or 'ends') and a duration such as '3h 20m'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@"
          }
        }
      }
    },
    "%@ rate window sample recorded since %@.": {
      "comment": "Delete dialog, singular. Placeholders: the sample count (always 1) and a date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rate window sample recorded since %2$@."
          }
        }
      }
    },
    "%@ rate window sample recorded.": {
      "comment": "Delete dialog, singular, with no earliest date on file. The placeholder is the sample count (always 1).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rate window sample recorded."
          }
        }
      }
    },
    "%@ rate window samples recorded since %@.": {
      "comment": "Delete dialog, plural. Placeholders: the sample count (2 or more) and a date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rate window samples recorded since %2$@."
          }
        }
      }
    },
    "%@ rate window samples recorded.": {
      "comment": "Delete dialog, plural, with no earliest date on file. The placeholder is the sample count (2 or more).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rate window samples recorded."
          }
        }
      }
    },
