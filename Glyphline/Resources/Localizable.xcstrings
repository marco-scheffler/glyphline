    "Glyphline" : {
      "shouldTranslate" : false
    },
    "Glyphline also syncs after the Mac wakes from sleep." : {
      "comment" : "Hint under the sync interval. 'Glyphline' is the app's name and stays.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline synchronisiert auch, nachdem der Mac aus dem Ruhezustand aufwacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline also syncs after the Mac wakes from sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline también sincroniza cuando el Mac sale del reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline se synchronise aussi à la sortie de veille du Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline sincronizza anche quando il Mac esce dallo stop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac がスリープから復帰したときにも Glyphline は同期します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glyphline também sincroniza quando o Mac sai do repouso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 从睡眠中唤醒后，Glyphline 也会同步。"
          }
        }
      }
    },
    "Glyphline builds the surface around the colour you pick: the hue is yours, the brightness is not. A dashboard has light text on it, so the background stays dark whatever you choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline baut die Oberfläche um die gewählte Farbe herum: Der Farbton kommt von dir, die Helligkeit nicht. Auf einem Dashboard steht heller Text, deshalb bleibt der Hintergrund dunkel, was immer du wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline builds the surface around the colour you pick: the hue is yours, the brightness is not. A dashboard has light text on it, so the background stays dark whatever you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline construye la superficie alrededor del color que elijas: el tono es tuyo, el brillo no. Un Dashboard lleva texto claro encima, así que el fondo se mantiene oscuro elijas lo que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline construit la surface autour de la couleur choisie : la teinte vient de vous, la luminosité non. Un Dashboard porte du texte clair, l’arrière-plan reste donc sombre quel que soit votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline costruisce la superficie attorno al colore scelto: la tonalità è tua, la luminosità no. Una Dashboard ha testo chiaro sopra, quindi lo sfondo resta scuro qualunque sia la scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline は選んだ色を中心に背景を組み立てます。色相は選んだとおりですが、明るさは違います。ダッシュボードには明るい文字が載るため、どの色を選んでも背景は暗いままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glyphline monta a superfície em torno da cor escolhida: a tonalidade é sua, o brilho não. Um Dashboard tem texto claro por cima, então o fundo continua escuro, seja qual for a escolha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline 会围绕所选颜色构建背景：色相由你决定，亮度不是。仪表板上是浅色文字，因此无论选哪种颜色，背景都保持深色。"
          }
        }
      }
    },
    "Glyphline checks once a day and always asks before installing anything." : {
      "comment" : "Explanation under the update controls in Settings. The promise that nothing installs itself is the point of the sentence — keep it explicit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline sucht einmal täglich und fragt immer nach, bevor etwas installiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline checks once a day and always asks before installing anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline busca una vez al día y siempre pregunta antes de instalar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline vérifie une fois par jour et demande toujours confirmation avant d’installer quoi que ce soit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline controlla una volta al giorno e chiede sempre conferma prima di installare qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline は 1 日 1 回確認し、インストールする前に必ず確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glyphline verifica uma vez por dia e sempre pergunta antes de instalar qualquer coisa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline 每天检查一次，并且在安装任何内容前都会先征求你的同意。"
          }
        }
      }
    },
    "Glyphline — quota available" : {
      "comment" : "VoiceOver name for the menu bar item. 'Glyphline' is the app's name and stays.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glyphline — Kontingent verfügbar"
