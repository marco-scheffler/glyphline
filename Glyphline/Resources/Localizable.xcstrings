      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — usage unknown, %2$@"
          }
        }
      }
    },
    "%@%lld %% vs. %@": {
      "comment": "Spend comparison. Placeholders: the sign (+ or −), the percentage change, and SpendPeriod.previousPhrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld %% vs. %3$@"
          }
        }
      }
    },
    "%@%lld %% vs. %lld-day median": {
      "comment": "Today's comparison line. Placeholders: the sign (+ or −), the percentage change, and the baseline length in days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld %% vs. %3$lld-day median"
          }
        }
