    "This cannot be recovered — claude.ai reports only the current figure, so this history exists nowhere else." : {
      "comment" : "Delete dialog: why the rate window history cannot be rebuilt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht wiederherstellen — claude.ai meldet nur den aktuellen Wert, dieser Verlauf existiert also nirgends sonst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be recovered — claude.ai reports only the current figure, so this history exists nowhere else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede recuperar — claude.ai solo informa la cifra actual, así que este historial no existe en ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est irrécupérable — claude.ai ne communique que la valeur actuelle, cet historique n’existe donc nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è recuperabile — claude.ai comunica solo il valore attuale, quindi questa cronologia non esiste altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは復元できません — claude.ai は現在の値しか返さないため、この履歴はほかのどこにも存在しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser recuperado — o claude.ai informa só o valor atual, então este histórico não existe em nenhum outro lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这无法恢复 — claude.ai 只报告当前数值，因此这份历史别处并不存在。"
          }
        }
      }
    },
