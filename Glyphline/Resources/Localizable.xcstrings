          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次同步失败。"
          }
        }
      }
    },
    "The stored quota token was rejected. Re-authorise this subscription." : {
      "comment" : "Quota failure reason: the provider answered 401 or 403 to the stored token.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gespeicherte Kontingent-Token wurde abgelehnt. Autorisiere dieses Abo neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored quota token was rejected. Re-authorise this subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó el token de cuota guardado. Vuelve a autorizar esta suscripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton de quota enregistré a été refusé. Autorisez de nouveau cet abonnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il token di quota salvato è stato rifiutato. Autorizza di nuovo questo abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているクォータ用トークンが拒否されました。このサブスクリプションを再認証してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token de cota salvo foi recusado. Autorize esta assinatura novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的配额令牌被拒绝。请重新授权此订阅。"
          }
        }
      }
    },
    "These figures cover every Claude subscription together. The transcripts carry no marker of which subscription paid for a session, so they cannot be attributed to one." : {
      "comment" : "Note under the Quotas section explaining that the totals cannot be split per subscription.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zahlen fassen alle Claude-Abos zusammen. Die Transkripte enthalten keinen Hinweis darauf, welches Abo eine Sitzung bezahlt hat, sie lassen sich also keinem einzelnen zuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These figures cover every Claude subscription together. The transcripts carry no marker of which subscription paid for a session, so they cannot be attributed to one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas cifras suman todas las suscripciones de Claude. Las transcripciones no indican qué suscripción pagó cada sesión, así que no se pueden atribuir a una sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces chiffres regroupent tous les abonnements Claude. Les transcriptions n’indiquent pas quel abonnement a payé une session, elles ne peuvent donc pas être attribuées à l’un d’eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste cifre comprendono tutti gli abbonamenti Claude insieme. Le trascrizioni non indicano quale abbonamento abbia pagato una sessione, quindi non possono essere attribuite a uno solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの数値はすべての Claude サブスクリプションを合算したものです。トランスクリプトにはどのサブスクリプションがセッションを負担したかの印がないため、個別には割り当てられません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes números somam todas as assinaturas do Claude. As transcrições não indicam qual assinatura pagou cada sessão, então não dá para atribuí-las a uma só."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些数字合并了所有 Claude 订阅。记录中没有标明哪个订阅支付了某次会话，因此无法归到单个订阅上。"
          }
        }
      }
    },
    "This account has no recorded history." : {
      "comment" : "Delete dialog for an account with nothing stored against it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
