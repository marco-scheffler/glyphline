<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "developer-id": Verteilung außerhalb des App Store. Nicht "development",
	     das signiert nur für registrierte Geräte und läuft auf keinem fremden Mac. -->
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>7YN7YUH475</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Notarisierung macht das Release-Skript selbst, nicht der Export: so
	     bleibt sichtbar, welcher Schritt fehlschlägt, und ein Export ohne
	     hinterlegte Zugangsdaten bricht nicht mittendrin ab. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
